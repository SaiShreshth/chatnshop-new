# -------- Shopify (choose ONE path or provide both) --------
# A) Storefront GraphQL (recommended for storefront-only access)
SHOPIFY_STOREFRONT_TOKEN=b9a2f6acd364455f3079968ea5f70465
SHOPIFY_DOMAIN=happyruh.com
SHOPIFY_API_VERSION=2024-10

# B) Admin REST (requires private app in Admin)
SHOPIFY_ADMIN_API_KEY=4215b958363fb6cec0e100786b540ecc
SHOPIFY_ADMIN_PASSWORD=33b229ce13665b1771d017a10a51eef9
# Either the "myshopify" short name (no .myshopify.com) or the full {shop}.myshopify.com
SHOPIFY_SHOP=your-shopify-subdomain-without-suffix

# -------- Qdrant --------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                         # leave empty if not using auth
QDRANT_COLLECTION=semantic_collection

# -------- Embeddings --------
EMBED_MODEL_NAME=all-MiniLM-L6-v2

# -------- Postgres --------
POSTGRES_DSN=postgresql://ruh:ruhpass@postgres:5432/happyruh

# -------- Worker (cron time in container local time) --------
CRON_TIME=03:10
